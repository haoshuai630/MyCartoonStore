<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>org.csu.mycartoonstore</groupId>
    <artifactId>mycartoonstore</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mycartoonstore</name>
    <description>漫屿 MANGA ISLE — 漫画及周边商店（SSM 实验一）</description>

    <modules>
        <module>cartoon-common</module>
        <module>cartoon-catalog</module>
        <module>cartoon-account</module>
        <module>cartoon-cart</module>
        <module>cartoon-order</module>
        <module>cartoon-payment</module>
        <module>cartoon-test-support</module>
        <module>cartoon-user-web</module>
        <module>cartoon-admin-web</module>
    </modules>

    <properties>
        <java.version>27</java.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- web 模块把它设为 true，跳过“业务模块不得依赖 Web starter”的检查 -->
        <enforcer.skip>false</enforcer.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-account</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-cart</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-order</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.csu.mycartoonstore</groupId>
                <artifactId>cartoon-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-module-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <skip>${enforcer.skip}</skip>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework.boot:spring-boot-starter-webmvc</exclude>
                                    </excludes>
                                    <message>业务模块不得依赖 Web starter：Web 依赖只允许出现在 cartoon-user-web / cartoon-admin-web</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
